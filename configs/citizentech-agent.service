[Unit]
Description=SombraSP - Agente CitizenTech (estado do no + monitor de CPU, memoria e disco)
After=network.target
RequiresMountsFor=/srv/citizentech/data
# 0 = nunca desiste de reiniciar (tolerancia a falhas mesmo com varias quedas seguidas)
StartLimitIntervalSec=0

[Service]
Type=simple
User=FelipeOliveira_RM556319
Group=citizenops
Environment=INTERVAL=30 CPU_MAX=80 MEM_MAX=80 DISK_MAX=80
ExecStart=/usr/local/bin/citizentech-agent.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
